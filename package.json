{
  "name": "nl-business-utils",
  "version": "0.1.0",
  "description": "Validation and formatting utilities for Dutch business identifiers: BSN, RSIN, KVK-nummer, BTW-nummer (VAT), IBAN, postcode, telefoonnummer and BTW calculations.",
  "keywords": [
    "bsn",
    "rsin",
    "kvk",
    "btw",
    "vat",
    "iban",
    "postcode",
    "netherlands",
    "dutch",
    "validation",
    "elfproef"
  ],
  "homepage": "https://github.com/NKB-Solutions-ORG/nl-business-utils-npm#readme",
  "bugs": {
    "url": "https://github.com/NKB-Solutions-ORG/nl-business-utils-npm/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NKB-Solutions-ORG/nl-business-utils-npm.git"
  },
  "license": "MIT",
  "author": "NKB Solutions",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
